# Server-side only. Never expose provider keys with NEXT_PUBLIC_ prefixes.
# Use a PostgreSQL connection string supplied by your chosen database host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/edge?schema=public"

# auto prefers API-Sports for Football/Basketball when configured,
# then falls back to The Odds API. Tennis uses The Odds API in Phase 3.
SPORTS_DATA_PROVIDER="auto"
API_SPORTS_KEY=""
ODDS_API_KEY=""
