# Server-side only. Never expose provider keys with NEXT_PUBLIC_ prefixes.
# Use a PostgreSQL connection string supplied by your chosen database host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/edge?schema=public"

# auto prefers API-Sports for Football/Basketball when configured,
# then falls back to The Odds API. Tennis uses The Odds API in Phase 3.
SPORTS_DATA_PROVIDER="auto"
API_SPORTS_KEY=""
ODDS_API_KEY=""

# API-Sports free plans expose a narrow rolling date window. EDGE therefore
# defaults to one day forward for events and one day backward for results.
# Paid plans can raise these deliberately, up to the provider's 14-day guard.
API_SPORTS_EVENT_FORWARD_HOURS="24"
API_SPORTS_RESULT_LOOKBACK_HOURS="24"

# Phase 5 odds sync controls. Defaults are deliberately conservative because
# The Odds API charges usage by returned market x requested region.
ODDS_API_REGIONS="eu"
ODDS_API_MARKETS="h2h"
ODDS_API_SPORT_KEYS=""
ODDS_SYNC_MAX_SPORT_KEYS="12"

# Event discovery cap applied before per-sport-key Odds API calls.
# Keep this small to protect quota; override deliberately for broader discovery.
ODDS_EVENT_MAX_SPORT_KEYS="4"

# Explicit Odds API completed-score sync cap. This path is quota-sensitive and
# is only used when deliberately invoked (for example --include-odds).
ODDS_RESULT_MAX_SPORT_KEYS="4"


# API-Sports football Match Winner fallback. The free plan is request-limited,
# so this command is intended for a controlled daily backfill, not every refresh.
API_SPORTS_ODDS_MAX_PAGES="45"
