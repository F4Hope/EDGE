# Server-side only. Never expose provider keys with NEXT_PUBLIC_ prefixes.
# Use a PostgreSQL connection string supplied by your chosen database host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/edge?schema=public"

# auto prefers API-Sports for Football/Basketball when configured,
# then falls back to The Odds API. Tennis uses The Odds API in Phase 3.
SPORTS_DATA_PROVIDER="auto"
API_SPORTS_KEY=""
ODDS_API_KEY=""

# API-Sports free plans expose a narrow rolling date window. Upcoming event
# discovery is clamped to the current UTC date by default so a late-day refresh
# does not cross into an unavailable future date. Paid plans may explicitly
# enable future dates. Results and historical evidence use rolling lookbacks.
API_SPORTS_EVENT_FORWARD_HOURS="24"
API_SPORTS_ALLOW_FUTURE_DATES="false"
API_SPORTS_RESULT_LOOKBACK_HOURS="24"
API_SPORTS_HISTORY_LOOKBACK_HOURS="48"
API_SPORTS_EVIDENCE_LOOKBACK_DAYS="60"
API_SPORTS_EVIDENCE_CHUNK_DAYS="5"

# Phase 5 odds sync controls. Defaults are deliberately conservative because
# The Odds API charges usage by returned market x requested region.
ODDS_API_REGIONS="eu"
ODDS_API_MARKETS="h2h,totals,spreads"
ODDS_API_SPORT_KEYS=""
ODDS_SYNC_MAX_SPORT_KEYS="12"

# Event discovery cap applied before per-sport-key Odds API calls.
# Keep this small to protect quota; override deliberately for broader discovery.
ODDS_EVENT_MAX_SPORT_KEYS="4"

# Extended soccer event discovery uses the quota-free /events endpoint and a
# curated major-league/international competition list over a 7-day horizon.
ODDS_SOCCER_EVENT_FORWARD_HOURS="168"

# Daily priority soccer pricing is intentionally H2H-only and capped. The worker
# discovers the full priority universe for free, then prices only the first active
# competition keys within this paid cap.
ODDS_PRIORITY_MAX_SPORT_KEYS="10"

# Explicit Odds API completed-score sync cap. This path is quota-sensitive and
# is only used when deliberately invoked (for example --include-odds).
ODDS_RESULT_MAX_SPORT_KEYS="4"


# API-Sports football Match Winner fallback. Target only upcoming fixtures that
# still lack H2H prices, with a hard daily request budget to protect the free plan.
API_SPORTS_ODDS_MAX_REQUESTS="40"
API_SPORTS_ODDS_FORWARD_HOURS="24"


# Rolling Combo refresh. This is intentionally bounded and uses API-Sports only
# for a small number of nearest unpriced fixtures. The broader paid Odds API
# pricing sweep remains on its separate daily schedule.
COMBO_REFRESH_MAX_ODDS_REQUESTS="4"
COMBO_REFRESH_ODDS_HOURS="24"
COMBO_REFRESH_MODEL_HOURS="168"

EDGE_FULL_REFRESH_EVERY_HOURS="8"
