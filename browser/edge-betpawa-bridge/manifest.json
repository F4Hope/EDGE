{
  "manifest_version": 3,
  "name": "EDGE BetPawa Cameroon Bridge",
  "version": "0.1.0",
  "description": "Loads EDGE Daily and Weekly Combo selections into a BetPawa Cameroon betslip. It never places a wager.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.betpawa.cm/*"],
  "content_scripts": [
    {
      "matches": ["https://www.betpawa.cm/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "EDGE BetPawa Cameroon Bridge"
  }
}
