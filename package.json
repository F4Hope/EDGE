{
  "name": "edge-sports-intelligence",
  "version": "0.8.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "data:sync": "tsx scripts/sync-events.ts",
    "test:providers": "tsx --test tests/providers.test.ts",
    "test:ui": "tsx --test tests/ui-routes.test.ts",
    "odds:sync": "tsx scripts/sync-odds.ts",
    "test:odds": "tsx --test tests/odds.test.ts",
    "features:calculate": "tsx scripts/calculate-features.ts",
    "test:features": "tsx --test tests/features.test.ts",
    "results:import": "tsx scripts/import-results.ts",
    "intelligence:import": "tsx scripts/import-intelligence.ts",
    "test:audit": "tsx --test tests/audit-intelligence.test.ts",
    "test:production": "tsx --test tests/production.test.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test:readiness": "tsx --test tests/readiness.test.ts",
    "check": "npm run db:validate && npm run test:providers && npm run test:provider-health && npm run test:odds && npm run test:features && npm run test:predictions && npm run test:opportunities && npm run test:combos && npm run test:form && npm run test:h2h && npm run test:audit && npm run test:production && npm run test:readiness && npm run test:freshness && npm run test:sync-checkpoints && npm run test:local-db && npm run test:codespace && npm run test:results-provider && npm run test:intelligence-provider && npm run test:web-intelligence && npm run test:event-changes && npm run test:data-refresh && npm run test:history-refresh && npm run test:analysis-refresh && npm run test:evidence-refresh-workflow && npm run test:deployment && npm run test:worker && npm run test:container && npm run test:operations && npm run test:api-production && npm run test:request-guards && npm run test:setup && npm run test:launch && npm run test:release && npm run test:ui && npm run lint && npm run build",
    "db:push": "prisma db push",
    "db:local": "tsx scripts/setup-local-db.ts",
    "db:local:stop": "docker compose -f docker-compose.local.yml down",
    "db:local:logs": "docker compose -f docker-compose.local.yml logs -f edge-db",
    "test:local-db": "tsx --test tests/local-db-setup.test.ts",
    "codespace:resume": "tsx scripts/resume-codespace.ts",
    "test:codespace": "tsx --test tests/codespace.test.ts",
    "results:sync": "tsx scripts/sync-results.ts",
    "test:results-provider": "tsx --test tests/results-provider.test.ts",
    "data:refresh": "tsx scripts/refresh-data.ts",
    "test:data-refresh": "tsx --test tests/data-refresh.test.ts",
    "intelligence:sync": "tsx scripts/sync-intelligence.ts",
    "test:intelligence-provider": "tsx --test tests/intelligence-provider.test.ts",
    "test:freshness": "tsx --test tests/freshness.test.ts",
    "test:event-changes": "tsx --test tests/event-changes.test.ts",
    "test:sync-checkpoints": "tsx --test tests/sync-checkpoints.test.ts",
    "audit:runtime": "npm audit --omit=dev --omit=optional --audit-level=high",
    "audit:critical": "npm audit --audit-level=critical",
    "test:evidence-refresh-workflow": "tsx --test tests/evidence-refresh-workflow.test.ts",
    "db:baseline:create": "tsx scripts/create-baseline-migration.ts",
    "db:deploy": "prisma migrate deploy",
    "deploy:preflight": "tsx scripts/production-preflight.ts",
    "test:deployment": "tsx --test tests/deployment.test.ts",
    "db:drift:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "test:container": "tsx --test tests/container.test.ts",
    "results:sync:odds": "tsx scripts/sync-odds-results.ts",
    "test:form": "tsx --test tests/form-features.test.ts",
    "test:h2h": "tsx --test tests/head-to-head.test.ts",
    "test:operations": "tsx --test tests/operations.test.ts",
    "test:api-production": "tsx --test tests/api-production.test.ts",
    "test:request-guards": "tsx --test tests/request-guards.test.ts",
    "test:setup": "tsx --test tests/setup-center.test.ts",
    "providers:check": "tsx scripts/check-providers.ts",
    "test:provider-health": "tsx --test tests/provider-health.test.ts",
    "launch:check": "tsx scripts/launch-check.ts",
    "test:launch": "tsx --test tests/launch-gate.test.ts",
    "release:check": "npm run audit:runtime && npm run audit:critical && npm run check",
    "test:release": "tsx --test tests/release.test.ts",
    "predictions:generate": "tsx scripts/generate-predictions.ts",
    "test:predictions": "tsx --test tests/predictions.test.ts",
    "test:worker": "tsx --test tests/worker-deployment.test.ts",
    "test:combos": "tsx --test tests/combos.test.ts",
    "events:reconcile": "tsx scripts/reconcile-event-providers.ts",
    "odds:sync:api-sports": "tsx scripts/sync-api-sports-odds.ts",
    "analysis:refresh": "tsx scripts/sync-api-sports-odds.ts --refresh-analysis=true",
    "test:opportunities": "tsx --test tests/opportunities.test.ts",
    "test:analysis-refresh": "tsx --test tests/analysis-refresh.test.ts",
    "history:refresh": "tsx scripts/refresh-history.ts",
    "test:history-refresh": "tsx --test tests/history-refresh.test.ts",
    "intelligence:sync:web": "tsx scripts/sync-web-intelligence.ts",
    "test:web-intelligence": "tsx --test tests/web-intelligence.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.4",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.2"
}
